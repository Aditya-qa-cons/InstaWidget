<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      No action bar: the screen draws its own gradient hero instead. Colours
      are set explicitly on every view rather than inherited, so the layout
      does not depend on the platform theme's idea of light or dark.
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/brand_purple</item>
    </style>

    <style name="StepTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="StepHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="ButtonPrimary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/on_brand</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="ButtonSecondary" parent="ButtonPrimary">
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/brand_purple</item>
        <item name="android:textStyle">normal</item>
    </style>

</resources>
